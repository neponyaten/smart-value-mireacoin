generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  displayName  String
  firstName    String?
  lastName     String?
  fullName     String
  group        String
  role         String    @default("Студент")
  userType     String    @default("user")
  passwordHash String
  coins        Int       @default(0)
  isBlocked    Boolean   @default(false)
  blockedAt    DateTime?
  blockedReason String?
  lastSeenAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  publicProfileSettings PublicProfileSettings?
  profileViewsReceived  ProfileView[]      @relation("ProfileOwnerViews")
  profileViewsSent      ProfileView[]      @relation("ProfileViewerViews")
  statuses              UserStatus[]
  reportsSent           ContentReport[]    @relation("ReporterReports")
  reportsOnUser         ContentReport[]    @relation("TargetUserReports")
  reportsReviewed       ContentReport[]    @relation("ContentReportReviewedBy")
  notifications         Notification[]
  userAchievements      UserAchievement[]
  userVfxGrants         UserVfxGrant[]
  adminAuditLogs        AdminAuditLog[]
  betaApplicationsDecided BetaApplication[] @relation("BetaApplicationDecidedBy")
  betaApplication       BetaApplication?  @relation("BetaApplicationUser")
  systemNotificationBatches SystemNotificationBatch[]
}

model PublicProfileSettings {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  bio           String   @default("")
  showInventory Boolean  @default(true)
  showGroup     Boolean  @default(true)
  showTelegram  Boolean  @default(false)
  showVk        Boolean  @default(false)
  showMax       Boolean  @default(false)
  telegramUrl   String   @default("")
  vkUrl         String   @default("")
  maxUrl        String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileView {
  id             Int      @id @default(autoincrement())
  profileOwnerId Int
  viewerUserId   Int
  viewedAt       DateTime @default(now())

  profileOwner User @relation("ProfileOwnerViews", fields: [profileOwnerId], references: [id], onDelete: Cascade)
  viewerUser   User @relation("ProfileViewerViews", fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@index([profileOwnerId, viewerUserId, viewedAt])
  @@index([profileOwnerId, viewedAt])
}

model UserStatus {
  id        Int      @id @default(autoincrement())
  userId    Int
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports ContentReport[]

  @@index([updatedAt])
  @@index([userId, updatedAt])
}

model ContentReport {
  id             Int      @id @default(autoincrement())
  reporterUserId Int
  targetUserId   Int?
  targetStatusId Int?
  targetType     String
  reason         String
  status         String   @default("pending") // pending, resolved, rejected
  reviewedByUserId Int?
  reviewedAt     DateTime?
  reviewComment  String?
  createdAt      DateTime @default(now())

  reporter   User       @relation("ReporterReports", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetUser User?      @relation("TargetUserReports", fields: [targetUserId], references: [id], onDelete: SetNull)
  targetStatus UserStatus? @relation(fields: [targetStatusId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ContentReportReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([targetType, targetUserId, targetStatusId])
  @@index([reporterUserId, createdAt])
}

model Notification {
  id          Int      @id @default(autoincrement())
  userId      Int
  type        String
  title       String
  description String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}

model Achievement {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  reward      Int      @default(0)
  rarity      String
  icon        String
  category    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@index([category, rarity])
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int
  achievementId Int
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model BetaApplication {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  fullName        String
  academicGroup   String
  requestedRole   String
  whyJoin         String
  telegramUrl     String?
  vkUrl           String?
  status          String   @default("pending") // pending, approved, rejected, invited, completed
  adminComment    String?
  decidedAt       DateTime?
  decidedByUserId Int?
  inviteToken     String?  @unique
  inviteSentAt    DateTime?
  userId          Int?     @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  decidedByUser User? @relation("BetaApplicationDecidedBy", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  user          User? @relation("BetaApplicationUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([status, createdAt])
}

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  actorRole String?
  action    String
  targetId  Int?
  targetUserId Int?
  targetType String?
  summary   String?
  details   String?
  changes   String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([actorRole, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@index([targetUserId, createdAt])
}

model EmailLog {
  id        Int      @id @default(autoincrement())
  to        String
  subject   String
  type      String
  status    String   @default("sent") // sent, failed
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@index([type, createdAt])
}

model VfxCatalogItem {
  id         Int      @id @default(autoincrement())
  name       String
  code       String   @unique
  rarity     String
  price      Int      @default(0)
  targetSlot String
  preview    String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users UserVfxGrant[]

  @@index([isActive, rarity])
}

model UserVfxGrant {
  id        Int      @id @default(autoincrement())
  userId    Int
  vfxItemId Int
  grantedAt DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vfxItem VfxCatalogItem @relation(fields: [vfxItemId], references: [id], onDelete: Cascade)

  @@unique([userId, vfxItemId])
  @@index([userId, grantedAt])
}

model SystemNotificationBatch {
  id              Int      @id @default(autoincrement())
  sentByUserId    Int
  targetType      String   // user, role, all
  targetValue     String?
  title           String
  message         String
  recipientsCount Int      @default(0)
  createdAt       DateTime @default(now())

  sentByUser User @relation(fields: [sentByUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([targetType, createdAt])
}
